---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import MessengerLinks from '@/components/ui/MessengerLinks.astro';
import ContactStrip from '@/components/contacts/ContactStrip.astro';
import { settings } from '@/lib/site';

const title = 'Контакты';
const description = `Напишите нам в WhatsApp или Telegram — подберём решение под ваш бюджет и запишем на бесплатный замер. Телефон ${settings.phone}, ${settings.address.city}, ${settings.address.street}.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Контакты — ${settings.siteName}`,
  description,
  url: new URL('/kontakty/', Astro.site).href,
  inLanguage: 'ru',
};
---

<BaseLayout title={title} description={description} tone="dark">
  <div class="container contacts">
    <div class="contacts__hero">
      <div class="contacts__intro">
        <Breadcrumbs tone="dark" items={[{ label: 'Главная', href: '/' }, { label: 'Контакты' }]} />
        <h1 class="contacts__title">Напишите нам — подберём решение под ваш бюджет</h1>
        <p class="contacts__lead">
          Менеджер ответит в мессенджере, уточнит детали и запишет на бесплатный замер. Можно сразу прислать фото
          объекта и примерные размеры.
        </p>
      </div>

      <div class="contacts__reach">
        <p class="contacts__caption">Выберите удобный мессенджер</p>
        <MessengerLinks tone="dark" details stack />
      </div>
    </div>

    <ContactStrip />
  </div>

  <JsonLd data={schema} />
</BaseLayout>

<style>
  .contacts {
    padding-top: 80px;
    padding-bottom: 66px;
  }

  .contacts__hero {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    column-gap: 80px;
    min-height: 652px;
    padding-bottom: 60px;
  }

  .contacts__intro {
    padding-top: 32px;
  }

  .contacts__title {
    margin-top: 7px;
    font-weight: 800;
    font-size: 55px;
    line-height: 60px;
    letter-spacing: -2px;
    color: #fff;
    text-wrap: pretty;
  }

  .contacts__reach {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 420px;
  }

  .contacts__caption {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 1.26px;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
  }

  .contacts__reach :global(.messenger) {
    min-height: 72px;
    padding-inline: 24px;
    font-size: 16px;
  }

  .contacts__lead {
    max-width: 380px;
    margin-top: 79px;
    font-size: 15px;
    line-height: 27px;
    color: rgb(255 255 255 / 0.55);
  }

  @media (max-width: 1199.98px) {
    .contacts {
      padding-top: 56px;
    }

    .contacts__hero {
      column-gap: 48px;
      min-height: 0;
    }

    .contacts__title {
      font-size: clamp(34px, 4.6vw, 55px);
      line-height: 1.09;
      letter-spacing: -0.035em;
    }

    .contacts__lead {
      margin-top: 40px;
    }
  }

  @media (max-width: 767.98px) {
    .contacts {
      padding-top: 24px;
      padding-bottom: 40px;
    }

    .contacts__hero {
      grid-template-columns: 1fr;
      row-gap: 40px;
      padding-bottom: 48px;
    }

    .contacts__intro {
      padding-top: 0;
    }

    .contacts__title {
      margin-top: 16px;
      font-size: clamp(30px, 8.4vw, 36px);
      line-height: 1.1;
      letter-spacing: -0.5px;
    }

    .contacts__lead {
      margin-top: 20px;
      font-size: 14px;
      line-height: 23px;
    }
  }
</style>
