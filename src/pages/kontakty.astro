---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import RequestForm from '@/components/contacts/RequestForm.astro';
import ContactStrip from '@/components/contacts/ContactStrip.astro';
import { settings } from '@/lib/site';

const title = 'Контакты и заявка на расчёт';
const description = `Оставьте заявку — менеджер перезвонит в течение 30 минут и запишет на бесплатный замер. Телефон ${settings.phone}, ${settings.address.city}, ${settings.address.street}.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Контакты — ${settings.siteName}`,
  description,
  url: new URL('/kontakty/', Astro.site).href,
  inLanguage: 'ru',
};
---

<BaseLayout title={title} description={description} tone="dark">
  <div class="container contacts">
    <div class="contacts__hero">
      <div class="contacts__intro">
        <Breadcrumbs tone="dark" items={[{ label: 'Главная', href: '/' }, { label: 'Контакты' }]} />
        <h1 class="contacts__title">Оставьте заявку и мы подберём решение под ваш бюджет</h1>
        <p class="contacts__lead">
          После отправки формы наш менеджер перезвонит в течение 30 минут, уточнит детали и запишет на бесплатный
          замер.
        </p>
      </div>

      <RequestForm class="contacts__form" source="contacts" />
    </div>

    <ContactStrip />
  </div>

  <JsonLd data={schema} />
</BaseLayout>

<style>
  .contacts {
    padding-top: 80px;
    padding-bottom: 66px;
  }

  .contacts__hero {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    column-gap: 80px;
    min-height: 652px;
    padding-bottom: 60px;
  }

  .contacts__intro {
    padding-top: 32px;
  }

  .contacts__title {
    margin-top: 7px;
    font-weight: 800;
    font-size: 55px;
    line-height: 60px;
    letter-spacing: -2px;
    color: #fff;
    text-wrap: pretty;
  }

  .contacts__lead {
    max-width: 380px;
    margin-top: 79px;
    font-size: 15px;
    line-height: 27px;
    color: rgb(255 255 255 / 0.55);
  }

  @media (max-width: 1199.98px) {
    .contacts {
      padding-top: 56px;
    }

    .contacts__hero {
      column-gap: 48px;
      min-height: 0;
    }

    .contacts__title {
      font-size: clamp(34px, 4.6vw, 55px);
      line-height: 1.09;
      letter-spacing: -0.035em;
    }

    .contacts__lead {
      margin-top: 40px;
    }
  }

  @media (max-width: 767.98px) {
    .contacts {
      padding-top: 24px;
      padding-bottom: 40px;
    }

    .contacts__hero {
      grid-template-columns: 1fr;
      row-gap: 40px;
      padding-bottom: 48px;
    }

    .contacts__intro {
      padding-top: 0;
    }

    .contacts__title {
      margin-top: 16px;
      font-size: clamp(30px, 8.4vw, 36px);
      line-height: 1.1;
      letter-spacing: -0.5px;
    }

    .contacts__lead {
      margin-top: 20px;
      font-size: 14px;
      line-height: 23px;
    }
  }
</style>
