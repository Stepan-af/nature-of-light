---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import DetailView from '@/components/portfolio/DetailView.astro';
import {
  availabilityLabel,
  availabilitySchema,
  categoryHref,
  getProducts,
  productHref,
  type Product,
} from '@/components/catalog/catalog';
import { formatPriceFrom, settings } from '@/lib/site';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => {
    // Prev/next within the same category.
    const siblings = products.filter((p) => p.data.category.id === product.data.category.id);
    const i = siblings.indexOf(product);
    const many = siblings.length > 1;
    return {
      params: { category: product.data.category.id, product: product.id },
      props: {
        product,
        prev: many ? siblings[(i - 1 + siblings.length) % siblings.length] : undefined,
        next: many ? siblings[(i + 1) % siblings.length] : undefined,
      },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  product: Product;
  prev?: Product;
  next?: Product;
}

const { product, prev, next } = Astro.props;
const { title, material, priceFrom, availability, image, imageAlt, gallery, specs, seo } = product.data;
const category = await getEntry(product.data.category);
if (!category) throw new Error(`Unknown category for product ${product.id}`);

const { Content } = await render(product);
const plain = (product.body ?? '').replace(/\s+/g, ' ').trim();
const items = gallery.length > 0 ? gallery : [{ image, alt: imageAlt }];

const ogImage = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const schemaImages = await Promise.all(
  items.slice(0, 4).map(async (item) => (await getImage({ src: item.image, width: 1200, format: 'jpg' })).src),
);

const pageUrl = new URL(productHref(product), Astro.site).href;
const description =
  seo?.description ??
  `${title} — ${material.toLowerCase()}, ${formatPriceFrom(priceFrom)}. ${plain ? `${plain.slice(0, 100).replace(/\s\S*$/, '')}…` : ''}`.trim();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: title,
  description: plain || description,
  image: [...new Set(schemaImages)].map((src) => new URL(src, Astro.site).href),
  category: category.data.title,
  material,
  url: pageUrl,
  brand: { '@type': 'Brand', name: settings.siteName },
  additionalProperty: specs.map((s) => ({ '@type': 'PropertyValue', name: s.label, value: s.value })),
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: priceFrom,
    priceCurrency: 'RUB',
    offerCount: 1,
    availability: availabilitySchema[availability],
    url: pageUrl,
    seller: { '@type': 'Organization', name: settings.siteName },
  },
};
---

<BaseLayout title={seo?.title ?? `${title} — купить ${formatPriceFrom(priceFrom)}`} {description} image={ogImage.src} tone="light">
  <JsonLd slot="head" data={schema} />
  <DetailView
    crumbs={[
      { label: 'Каталог', href: '/catalog/' },
      { label: category.data.title, href: categoryHref(category) },
      { label: title },
    ]}
    badge={category.data.title}
    title={title}
    gallery={items}
    paramsLabel="Параметры"
    params={[
      { label: 'Стоимость', value: formatPriceFrom(priceFrom) },
      { label: 'Материал', value: material },
      { label: 'Наличие', value: availabilityLabel[availability] },
      ...specs,
    ]}
    aboutLabel="Описание"
    ctaHref={`/kontakty/?product=${product.id}`}
    prev={prev && { href: productHref(prev), title: prev.data.title }}
    next={next && { href: productHref(next), title: next.data.title }}
    pagerLabel="Другие товары категории"
    showAbout={Boolean(plain)}
  >
    <Content />
  </DetailView>
</BaseLayout>
