---
import type { HTMLAttributes } from 'astro/types';

type Variant =
  /** Translucent glass on photos/dark: hero "Перейти в каталог". */
  | 'glass'
  /** Transparent with light outline on photos/dark: hero "Наши работы". */
  | 'ghost'
  /** Solid brand green. */
  | 'primary'
  /** Grey → white on hover, for green backgrounds. */
  | 'light'
  /** Thin outline on dark backgrounds. */
  | 'outline';

type Props = {
  variant?: Variant;
  size?: 'sm' | 'md';
  block?: boolean;
  class?: string;
} & (({ href: string } & HTMLAttributes<'a'>) | ({ href?: undefined } & HTMLAttributes<'button'>));

const { variant = 'primary', size = 'md', block = false, class: className, href, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, `btn--${size}`, { 'btn--block': block }, className];
---

{
  href ? (
    <a class:list={classes} href={href} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} type="button" {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid transparent;
    border-radius: var(--radius-xs);
    font-family: var(--font-body);
    font-weight: 600;
    white-space: nowrap;
    text-align: center;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn--md {
    min-height: 47px;
    padding: 12px 24px;
    font-size: 14px;
    line-height: 21px;
    letter-spacing: 0.01em;
  }

  .btn--sm {
    min-height: 36px;
    padding: 7px 18px;
    font-size: 13px;
    line-height: 19.5px;
  }

  .btn--block {
    display: flex;
    width: 100%;
  }

  .btn--glass {
    color: #fff;
    background: rgb(117 117 117 / 0.09);
    border-color: rgb(255 255 255 / 0.18);
    box-shadow: inset 0 0 12px rgb(255 255 255 / 0.04);
    backdrop-filter: blur(8px);
  }

  .btn--glass:hover {
    background: rgb(46 125 50 / 0.2);
  }

  .btn--glass:active {
    background: rgb(39 146 44 / 0.23);
  }

  .btn--ghost {
    color: #fff;
    background: transparent;
    border-color: rgb(255 255 255 / 0.18);
    backdrop-filter: blur(8px);
  }

  .btn--ghost:hover {
    background: rgb(46 125 50 / 0.1);
  }

  .btn--ghost:active {
    background: rgb(7 239 19 / 0.1);
  }

  .btn--primary {
    color: #fff;
    background: var(--color-green);
    box-shadow: 0 2px 4px rgb(46 125 50 / 0.22);
  }

  .btn--primary:hover {
    background: var(--color-green-deep);
  }

  .btn--primary:active {
    background: var(--color-green-pressed);
  }

  .btn--light {
    border-radius: var(--radius-sm);
    font-weight: 700;
    color: #fff;
    background: var(--color-text-muted);
  }

  .btn--light:hover {
    color: var(--color-green);
    background: #fff;
  }

  .btn--light:active {
    color: var(--color-green-pressed);
    background: #fff;
  }

  .btn--outline {
    border-radius: 4px;
    color: #fff;
    border-color: rgb(255 255 255 / 0.3);
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .btn--outline:hover {
    border-color: #fff;
    background: rgb(255 255 255 / 0.06);
  }
</style>
