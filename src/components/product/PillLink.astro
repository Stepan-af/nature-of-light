---
/*
 * Outline pill link — Figma UI kit «кнопка для доп страницы» (1075:1687):
 * green 1px outline, 24px radius, 38px high; hover = green tint, active = darker tint.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  href: string;
  /** Surface the link sits on. */
  tone?: 'light' | 'dark';
  /** Stretch to the container width (mobile CTA). */
  block?: boolean;
};

const { href, tone = 'light', block = false, class: className, ...rest } = Astro.props;
---

<a class:list={['pill', `pill--${tone}`, { 'pill--block': block }, className]} href={href} {...rest}>
  <slot />
  <span class="pill__arrow" aria-hidden="true">→</span>
</a>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 38px;
    padding: 8px 18px;
    border: 1px solid var(--color-green-bright);
    border-radius: 24px;
    font-weight: 500;
    font-size: 13px;
    line-height: 19.5px;
    text-align: center;
    color: #4f5550;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .pill:hover {
    background: rgb(35 115 39 / 0.12);
    color: var(--color-text);
  }

  .pill:active {
    background: rgb(26 56 28 / 0.19);
  }

  .pill--dark {
    color: rgb(255 255 255 / 0.8);
  }

  .pill--dark:hover {
    color: #fff;
  }

  .pill--block {
    width: 100%;
  }

  .pill__arrow {
    transition: transform var(--duration) var(--ease);
  }

  .pill:hover .pill__arrow {
    transform: translateX(3px);
  }
</style>
