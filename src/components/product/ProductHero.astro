---
/*
 * First screen of the product page (Figma 1002:1538 «Первый экран»):
 * breadcrumbs, gallery and the white card with the title and key specs.
 */
import Breadcrumbs, { type Crumb } from '@/components/ui/Breadcrumbs.astro';
import ProductGallery, { type GalleryItem } from './ProductGallery.astro';

export interface Props {
  crumbs: Crumb[];
  badge: string;
  title: string;
  gallery: GalleryItem[];
  /** Formatted «от …» price; omitted for products priced on request. */
  price?: string;
  rows: { label: string; value: string }[];
  /** Render the default slot (short description) under the title. */
  hasLead?: boolean;
}

const { crumbs, badge, title, gallery, price, rows, hasLead = false } = Astro.props;
---

<section class="phero" aria-labelledby="product-title">
  <div class="pd-container">
    <Breadcrumbs class="phero__crumbs" items={crumbs} />

    <div class="phero__grid">
      <ProductGallery items={gallery} {badge} />

      <div class="buy">
        <h1 class="buy__title" id="product-title">{title}</h1>
        {hasLead && <div class="buy__lead"><slot /></div>}

        {
          price && (
            <p class="buy__price">
              <span class="buy__price-label">Цена</span>
              <span class="buy__price-value">{price}</span>
            </p>
          )
        }

        {
          rows.length > 0 && (
            <dl class="buy__rows">
              {rows.map((row) => (
                <div class="buy__row">
                  <dt>{row.label}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .phero {
    padding-block: 28px 72px;
    background: #f6f6f4;
  }

  .phero :global(.crumbs ol) {
    justify-content: center;
    font-size: 12px;
    line-height: 1.4;
  }

  .phero :global(.crumbs [aria-current]) {
    font-size: 12px;
  }

  .phero__grid {
    display: grid;
    grid-template-columns: minmax(0, 900fr) minmax(340px, 475fr);
    align-items: start;
    gap: 16px;
    margin-top: 28px;
  }

  /* ---------- Purchase card ---------- */
  /* Stretch to the gallery height (Figma: both 684px), content stays at the top. */
  .buy {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
    padding: clamp(24px, 2.6vw, 38px);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: 0 12px 36px rgb(17 16 24 / 0.07);
  }

  .buy__title {
    font-size: clamp(30px, 3.1vw, 48px);
    line-height: 1.1;
    letter-spacing: -1px;
    color: #111018;
  }

  .buy__lead {
    font-size: 15px;
    line-height: 1.55;
    color: #717770;
  }

  .buy__lead :global(p + p) {
    margin-top: 8px;
  }

  .buy__price {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .buy__price-label {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #717770;
  }

  .buy__price-value {
    font-weight: 700;
    font-size: clamp(28px, 2.3vw, 34px);
    line-height: 1.2;
    letter-spacing: -0.5px;
    color: #111018;
  }

  .buy__rows {
    font-size: 13px;
    line-height: 1.35;
  }

  .buy__row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 13px;
    border-top: 1px solid #d8ddd7;
  }

  .buy__row dt {
    color: #717770;
  }

  .buy__row dd {
    font-weight: 600;
    text-align: right;
    color: #111018;
  }

  @media (max-width: 1199.98px) {
    .phero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 767.98px) {
    .phero {
      padding-block: 16px 40px;
    }

    .phero__grid {
      margin-top: 16px;
    }

    .buy {
      padding: 32px 24px;
    }

    .buy__title {
      font-size: 28px;
    }
  }
</style>
