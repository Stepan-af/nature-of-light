---
/*
 * Photo + text blocks (Figma 1002:1594 «Подробности»): image left / text right,
 * then text left / image right, and so on. Optional quote, link and stats.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PillLink from './PillLink.astro';

type Story = CollectionEntry<'products'>['data']['story'];

export interface Props {
  blocks: Story;
}

const { blocks } = Astro.props;
---

<section class="pstory pd-section" aria-label="Подробнее о конструкции">
  <div class="pd-container pstory__list">
    {
      blocks.map((block, i) => (
        <article class:list={['pstory__block', { 'pstory__block--flip': i % 2 === 1 }]}>
          <Image
            class="pstory__img"
            src={block.image}
            alt={block.imageAlt}
            width={1640}
            widths={[400, 700, 1000, 1640]}
            sizes="(max-width: 767.98px) calc(100vw - 32px), (max-width: 1199.98px) 55vw, 820px"
            loading="lazy"
          />
          <div class="pstory__body">
            <h2 class="pd-title">{block.title}</h2>
            <p class="pd-text pstory__text">{block.text}</p>
            {block.quote && <p class="pstory__quote">{block.quote}</p>}
            {
              block.stats && block.stats.length > 0 && (
                <dl class="pstory__stats">
                  {block.stats.map((stat) => (
                    <div class="pstory__stat">
                      <dt>{stat.label}</dt>
                      <dd>{stat.value}</dd>
                    </div>
                  ))}
                </dl>
              )
            }
            {block.link && <PillLink href={block.link.href}>{block.link.label}</PillLink>}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .pstory {
    background: #f6f6f4;
  }

  .pstory__list {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 5.6vw, 78px);
  }

  .pstory__block {
    display: grid;
    grid-template-columns: minmax(0, 820fr) minmax(0, 555fr);
    align-items: center;
    gap: clamp(24px, 3vw, 48px);
  }

  .pstory__block--flip {
    grid-template-columns: minmax(0, 555fr) minmax(0, 820fr);
  }

  .pstory__block--flip .pstory__img {
    order: 2;
  }

  .pstory__img {
    width: 100%;
    height: auto;
    aspect-ratio: 820 / 600;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  .pstory__block--flip .pstory__img {
    aspect-ratio: 820 / 540;
  }

  .pstory__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .pstory__quote {
    margin-top: 10px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(20px, 1.7vw, 24px);
    line-height: 1.25;
    color: #1a1a1a;
  }

  .pstory__quote + :global(.pill),
  .pstory__stats + :global(.pill) {
    margin-top: 10px;
  }

  .pstory__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 42px;
    margin-top: 8px;
  }

  .pstory__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
  }

  .pstory__stat dd {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 2.2vw, 32px);
    line-height: 1.2;
    color: #000;
  }

  .pstory__stat dt {
    font-size: 12px;
    line-height: 1.3;
    color: #717770;
  }

  @media (max-width: 767.98px) {
    .pstory__block,
    .pstory__block--flip {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .pstory__block--flip .pstory__img {
      order: 0;
    }

    .pstory__img,
    .pstory__block--flip .pstory__img {
      aspect-ratio: 345 / 470;
    }

    .pstory__body {
      gap: 16px;
    }
  }
</style>
