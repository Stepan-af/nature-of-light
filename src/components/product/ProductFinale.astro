---
/*
 * Closing banner (Figma 1002:1712 «Финальный призыв»): full-width photo,
 * dark green overlay, large title at the bottom left.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

type Finale = NonNullable<CollectionEntry<'products'>['data']['finale']>;

export interface Props {
  data: Finale;
}

const { data } = Astro.props;
---

<section class="pfin">
  <Image
    class="pfin__img"
    src={data.image}
    alt={data.imageAlt}
    width={1920}
    widths={[640, 1024, 1560, 1920]}
    sizes="100vw"
    loading="lazy"
  />
  <div class="pd-container pfin__content">
    <h2 class="pfin__title">{data.title}</h2>
  </div>
</section>

<style>
  .pfin {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(320px, 33.4vw, 520px);
    padding-block: clamp(40px, 5vw, 76px);
    overflow: hidden;
    background: #111018;
    isolation: isolate;
  }

  .pfin__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pfin::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(7 16 11 / 0.71);
  }

  .pfin__title {
    max-width: 840px;
    font-size: clamp(32px, 4.2vw, 60px);
    line-height: 1.07;
    letter-spacing: -1.5px;
    color: #fff;
  }
</style>
