---
import Breadcrumbs, { type Crumb } from '@/components/ui/Breadcrumbs.astro';
import MessengerLinks from '@/components/ui/MessengerLinks.astro';
import Gallery, { type GalleryItem } from './Gallery.astro';

export interface Props {
  crumbs: Crumb[];
  badge: string;
  title: string;
  gallery: GalleryItem[];
  aboutLabel: string;
  /** Prefilled WhatsApp message for the «Хотите похожую конструкцию?» card. */
  ctaMessage: string;
  /** Render the description block (default slot). */
  showAbout?: boolean;
}

const { crumbs, badge, title, gallery, aboutLabel, ctaMessage, showAbout = true } = Astro.props;
const hasAbout = showAbout && Astro.slots.has('default');
---

<div class="detail container">
  <Breadcrumbs items={crumbs} />

  <div class="detail__grid">
    <div class="detail__main">
      <div class="detail__gallery">
        <Gallery items={gallery} />
      </div>

      {
        hasAbout && (
          <section class="detail__about" aria-labelledby="detail-about">
            <h2 class="detail__label" id="detail-about">
              {aboutLabel}
            </h2>
            <div class="detail__text">
              <slot />
            </div>
          </section>
        )
      }
    </div>

    <div class="detail__aside">
      <header class="detail__head">
        <p class="detail__badge">{badge}</p>
        <h1 class="detail__title">{title}</h1>
      </header>

      <section class="cta" aria-labelledby="detail-cta">
        <h2 class="cta__title" id="detail-cta">Хотите похожую конструкцию?</h2>
        <p class="cta__text">Напишите нам — рассчитаем стоимость и сроки бесплатно</p>
        <MessengerLinks class="cta__links" tone="green" message={ctaMessage} stack />
      </section>
    </div>
  </div>
</div>

<style>
  .detail {
    padding-block: 36px 64px;
  }

  .detail__grid {
    display: grid;
    grid-template-columns: minmax(0, 772fr) minmax(290px, 340fr);
    gap: 40px;
    align-items: start;
    margin-top: 28px;
  }

  .detail__main,
  .detail__aside {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .detail__aside {
    gap: 12px;
  }

  /* ---------- About ---------- */
  .detail__about {
    padding-top: 28px;
  }

  .detail__label {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 11px;
    line-height: 15px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--color-green);
  }

  .detail__text {
    padding-top: 10px;
    font-size: 15px;
    line-height: 27px;
    color: var(--color-text);
  }

  .detail__text :global(p + p),
  .detail__text :global(ul),
  .detail__text :global(ol) {
    margin-top: 12px;
  }

  .detail__text :global(a) {
    color: var(--color-green);
    text-decoration: underline;
  }

  /* ---------- Head ---------- */
  .detail__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .detail__badge {
    padding: 3px 10px;
    border: 1px solid rgb(46 125 50 / 0.16);
    border-radius: 20px;
    background: var(--color-green-tint-8);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 11px;
    line-height: 16.5px;
    letter-spacing: 0.66px;
    text-transform: uppercase;
    color: #1f6a24;
  }

  .detail__title {
    font-size: 28px;
    line-height: 1.2;
    color: var(--color-text);
  }

  /* ---------- CTA ---------- */
  .cta {
    padding: 22px 20px;
    border-radius: var(--radius-card);
    background: var(--color-green);
    color: #fff;
  }

  .cta__title {
    font-size: 18px;
    line-height: 21.6px;
  }

  .cta__text {

    padding-top: 8px;
    font-size: 13px;
    line-height: 19.5px;
    color: #fff;
  }

  .cta :global(.cta__links) {
    margin-top: 16px;
  }


  @media (max-width: 767.98px) {
    .detail {
      padding-block: 16px 48px;
    }

    /* Single column: title → gallery → CTA → about. */
    .detail__grid {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      margin-top: 12px;
    }

    .detail__main,
    .detail__aside {
      display: contents;
    }

    .detail__head {
      order: 1;
      gap: 8px;
    }

    .detail__gallery {
      order: 2;
    }

    .cta {
      order: 3;
    }

    .detail__about {
      order: 4;
      padding-top: 8px;
    }

    .detail__title {
      font-size: 26px;
    }

    .detail__text {
      font-size: 15px;
      line-height: 25px;
    }
  }
</style>
