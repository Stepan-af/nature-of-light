---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

export interface GalleryItem {
  image: ImageMetadata;
  alt: string;
}

export interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
const total = items.length;
const pad = (n: number) => String(n).padStart(2, '0');

// Full-size versions for the "Открыть" link / lightbox.
const full = await Promise.all(
  items.map(async ({ image, alt }) => {
    const img = await getImage({ src: image, width: Math.min(image.width, 1920), format: 'webp' });
    return { src: img.src, alt };
  }),
);
---

<div class="gallery" data-gallery data-full={JSON.stringify(full)}>
  <div class="gallery__main" data-gallery-main>
    {
      items.map((item, i) => (
        <div class="gallery__slide" data-gallery-slide hidden={i !== 0}>
          <Image
            class="gallery__img"
            src={item.image}
            alt={item.alt}
            width={1544}
            widths={[480, 768, 1080, 1544]}
            sizes="(max-width: 767.98px) calc(100vw - 32px), (max-width: 1199.98px) 62vw, 772px"
            priority={i === 0}
          />
        </div>
      ))
    }
    <p class="gallery__counter" aria-live="polite">
      <span class="visually-hidden">Фото</span>
      <span data-gallery-counter>{pad(1)} / {pad(total)}</span>
    </p>
    <a class="gallery__open" href={full[0]?.src} data-gallery-open aria-haspopup="dialog">
      Открыть<span class="visually-hidden"> фото в полном размере</span>
    </a>
  </div>

  {
    total > 1 && (
      <ul class="gallery__thumbs" role="list" aria-label="Все фото">
        {items.map((item, i) => (
          <li>
            <a
              class="gallery__thumb"
              href={full[i]?.src}
              data-gallery-thumb
              aria-current={i === 0 ? 'true' : undefined}
              aria-label={`Показать фото ${i + 1} из ${total}`}
            >
              <Image src={item.image} alt="" width={374} widths={[200, 374]} sizes="(max-width: 767.98px) 25vw, 187px" />
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <dialog class="lightbox" data-lightbox aria-label="Просмотр фото">
    <div class="lightbox__frame">
      <img class="lightbox__img" alt="" data-lightbox-img decoding="async" />
    </div>
    <p class="lightbox__counter" data-lightbox-counter>{pad(1)} / {pad(total)}</p>
    <button class="lightbox__btn lightbox__close" type="button" data-lightbox-close aria-label="Закрыть">×</button>
    {
      total > 1 && (
        <>
          <button class="lightbox__btn lightbox__prev" type="button" data-lightbox-prev aria-label="Предыдущее фото">
            ←
          </button>
          <button class="lightbox__btn lightbox__next" type="button" data-lightbox-next aria-label="Следующее фото">
            →
          </button>
        </>
      )
    }
  </dialog>
</div>

<script>
  interface FullImage {
    src: string;
    alt: string;
  }

  const pad = (n: number) => String(n).padStart(2, '0');

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const full = JSON.parse(root.dataset.full ?? '[]') as FullImage[];
    const total = full.length;
    if (!total) return;

    const main = root.querySelector<HTMLElement>('[data-gallery-main]');
    const slides = [...root.querySelectorAll<HTMLElement>('[data-gallery-slide]')];
    const thumbs = [...root.querySelectorAll<HTMLAnchorElement>('[data-gallery-thumb]')];
    const counter = root.querySelector<HTMLElement>('[data-gallery-counter]');
    const openLink = root.querySelector<HTMLAnchorElement>('[data-gallery-open]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');
    const lightboxImg = root.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const lightboxCounter = root.querySelector<HTMLElement>('[data-lightbox-counter]');
    let index = 0;

    const show = (next: number) => {
      index = (next + total) % total;
      slides.forEach((slide, i) => (slide.hidden = i !== index));
      thumbs.forEach((thumb, i) => {
        if (i === index) thumb.setAttribute('aria-current', 'true');
        else thumb.removeAttribute('aria-current');
      });
      const label = `${pad(index + 1)} / ${pad(total)}`;
      if (counter) counter.textContent = label;
      if (lightboxCounter) lightboxCounter.textContent = label;
      const item = full[index];
      if (item && openLink) openLink.href = item.src;
      // Only fetch the full-size photo while the lightbox is open.
      if (item && lightboxImg && dialog?.open) {
        lightboxImg.src = item.src;
        lightboxImg.alt = item.alt;
      }
    };

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', (event) => {
        event.preventDefault();
        show(i);
      });
      thumb.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        show(index + (event.key === 'ArrowRight' ? 1 : -1));
        thumbs[index]?.focus();
      });
    });

    openLink?.addEventListener('click', (event) => {
      if (!dialog) return;
      event.preventDefault();
      dialog.showModal();
      show(index);
    });

    dialog?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog?.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(index - 1));
    dialog?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(index + 1));
    dialog?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.classList.contains('lightbox__frame')) dialog.close();
    });
    dialog?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
    dialog?.addEventListener('close', () => openLink?.focus());

    // Swipe on the main image (touch devices).
    let startX: number | null = null;
    main?.addEventListener('touchstart', (event) => (startX = event.touches[0]?.clientX ?? null), { passive: true });
    main?.addEventListener(
      'touchend',
      (event) => {
        const endX = event.changedTouches[0]?.clientX;
        if (startX === null || endX === undefined || total < 2) return;
        const dx = endX - startX;
        if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
        startX = null;
      },
      { passive: true },
    );
  });
</script>

<style is:global>
  /* Lock page scroll behind the open lightbox. */
  html:has(dialog.lightbox[open]) {
    overflow: hidden;
  }
</style>

<style>
  .gallery__main {
    position: relative;
    aspect-ratio: 772 / 482.5;
    overflow: hidden;
    background: var(--color-surface);
    border-radius: 18px;
  }

  .gallery__slide {
    position: absolute;
    inset: 0;
  }

  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Subtle zoom on hover (Figma comment «эффект зума»); pointer devices only. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .gallery__img {
      transition: transform 450ms var(--ease);
    }

    .gallery__main:hover .gallery__img {
      transform: scale(1.05);
    }
  }

  .gallery__counter {
    position: absolute;
    left: 14px;
    bottom: 14px;
    padding: 2px 8px;
    border-radius: 20px;
    background: rgb(0 0 0 / 0.3);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16.5px;
    color: rgb(255 255 255 / 0.85);
    pointer-events: none;
  }

  .gallery__open {
    position: absolute;
    right: 14px;
    bottom: 14px;
    padding: 5px 12px;
    border-radius: 20px;
    background: rgb(0 0 0 / 0.45);
    font-size: 12px;
    line-height: 18px;
    color: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(6px);
    transition: background-color var(--duration) var(--ease);
  }

  .gallery__open:hover {
    background: rgb(0 0 0 / 0.65);
  }

  .gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: 12px;
  }

  .gallery__thumb {
    display: block;
    aspect-ratio: 187 / 137;
    overflow: hidden;
    border: 3px solid transparent;
    border-radius: 12px;
    opacity: 0.6;
    transition:
      opacity var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 9px;
  }

  .gallery__thumb:hover {
    opacity: 0.85;
  }

  .gallery__thumb[aria-current='true'] {
    border-color: var(--color-green);
    border-radius: 10px;
    opacity: 1;
  }

  .gallery__thumb[aria-current='true'] img {
    border-radius: 7px;
  }

  /* ---------- Lightbox ---------- */
  .lightbox {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: 0;
    border: 0;
    background: rgb(10 11 9 / 0.94);
    color: #fff;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .lightbox__frame {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 64px clamp(16px, 7vw, 96px);
  }

  .lightbox__img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100dvh - 128px);
    object-fit: contain;
    border-radius: var(--radius-md);
  }

  .lightbox__counter {
    position: absolute;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: rgb(255 255 255 / 0.7);
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    font-size: 22px;
    line-height: 1;
    color: #fff;
    transition: background-color var(--duration) var(--ease);
  }

  .lightbox__btn:hover {
    background: rgb(46 125 50 / 0.5);
  }

  .lightbox__close {
    top: 12px;
    right: 12px;
    font-size: 28px;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__prev {
    left: clamp(8px, 2vw, 32px);
  }

  .lightbox__next {
    right: clamp(8px, 2vw, 32px);
  }

  @media (max-width: 767.98px) {
    .gallery__main {
      aspect-ratio: 4 / 3;
      border-radius: 16px;
    }

    .gallery__thumbs {
      gap: 6px;
      margin-top: 8px;
    }

    .gallery__thumb {
      border-width: 2px;
      border-radius: 8px;
    }

    .gallery__thumb img {
      border-radius: 6px;
    }

    .gallery__thumb[aria-current='true'] {
      border-radius: 8px;
    }

    .gallery__thumb[aria-current='true'] img {
      border-radius: 6px;
    }

    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 8px;
      transform: none;
    }
  }
</style>
