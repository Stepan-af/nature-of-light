---
import { Image } from 'astro:assets';
import { projectHref, type Project } from './portfolio';

export interface Props {
  project: Project;
  /** Load the photo eagerly (first cards above the fold). */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { title, badge, location, cover, coverAlt } = project.data;
---

<a class="pcard" href={projectHref(project)}>
  <Image
    class="pcard__img"
    src={cover}
    alt={coverAlt}
    width={760}
    widths={[400, 560, 760, 1000]}
    sizes="(max-width: 899.98px) 50vw, (max-width: 1199.98px) 33vw, 380px"
    loading={eager ? 'eager' : 'lazy'}
  />
  <span class="pcard__badge">{badge}</span>
  <span class="pcard__caption">
    <span class="pcard__title">{title}</span>
    <span class="pcard__location">{location}</span>
  </span>
</a>

<style>
  .pcard {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: 22px;
    background: var(--color-warm-white);
    box-shadow: var(--shadow-card);
    isolation: isolate;
  }

  .pcard__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Subtle zoom on hover (Figma comment «эффект зума»). */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pcard__img {
      transition: transform 450ms var(--ease);
    }

    .pcard:hover .pcard__img {
      transform: scale(1.05);
    }
  }

  .pcard:focus-visible {
    outline: 2px solid var(--color-green);
    outline-offset: 3px;
  }

  /* Figma v2 (comment «поменял у плашек цвет»): solid grey pill, white text. */
  .pcard__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 12px;
    border: 1px solid rgb(255 255 255 / 0.92);
    border-radius: var(--radius-pill);
    background: var(--color-text-muted);
    filter: drop-shadow(0 8px 20px rgb(0 0 0 / 0.08));
    font-weight: 700;
    font-size: 11px;
    line-height: 14px;
    letter-spacing: 0.18px;
    color: #fff;
  }

  .pcard__caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px 12px;
    background: linear-gradient(90deg, rgb(48 44 40 / 0.55) 0%, rgb(120 120 118 / 0.38) 55%, rgb(235 235 235 / 0.28) 100%);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    color: #fff;
  }

  .pcard__title {
    overflow: hidden;
    font-weight: 600;
    font-size: 14px;
    line-height: 17px;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.25);
  }

  .pcard__location {
    overflow: hidden;
    min-width: 0;
    font-size: 11px;
    line-height: 15px;
    color: rgb(255 255 255 / 0.75);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  @media (max-width: 767.98px) {
    .pcard {
      border-radius: 18px;
    }

    .pcard__badge {
      top: 8px;
      left: 8px;
      padding: 2px 8px;
      font-size: 10px;
    }

    .pcard__caption {
      gap: 2px;
      padding: 10px 12px;
    }

    .pcard__title {
      font-size: 13px;
      line-height: 16px;
    }

  }
</style>
