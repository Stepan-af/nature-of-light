---
import { getCollection } from 'astro:content';
import MeasureIcon from '@/assets/home/icons/adv-measure.svg';
import FactoryIcon from '@/assets/home/icons/adv-factory.svg';
import InstallIcon from '@/assets/home/icons/adv-install.svg';
import WarrantyIcon from '@/assets/home/icons/adv-warranty.svg';

import source from '@/content/data/advantages.json';

// The file loader doesn't keep array order — follow the order set in the CMS.
const order = source.items.map((item) => item.id);
const advantages = (await getCollection('advantages')).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));

const icons = {
  measure: MeasureIcon,
  factory: FactoryIcon,
  install: InstallIcon,
  warranty: WarrantyIcon,
};
---

<section class="advantages" aria-labelledby="advantages-title">
  <div class="container">
    <h2 class="section-title advantages__title" id="advantages-title">Услуги</h2>
    <ul class="advantages__list" role="list">
      {
        advantages.map(({ data }) => {
          const Icon = icons[data.icon];
          return (
            <li class="adv" data-icon={data.icon}>
              <span class="adv__icon">
                <Icon width={20} height={20} aria-hidden="true" />
              </span>
              <h3 class="adv__title">{data.title}</h3>
              <p class="adv__text">{data.text}</p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .advantages {
    padding-block: 100px 72px;
    border-bottom: 1px solid var(--color-border);
  }

  .advantages__title {
    font-size: 38px;
    line-height: 1.5;
  }

  .advantages__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 40px;
  }

  .adv {
    padding: 24px 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    transition:
      transform 400ms var(--ease),
      box-shadow 400ms var(--ease),
      border-color 400ms var(--ease);
  }

  @media (hover: hover) {
    .adv:hover {
      border-color: transparent;
      box-shadow: var(--shadow-card);
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .adv:hover {
      transform: none;
    }
  }

  .adv__icon {
    --tint: 46 125 50;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(var(--tint) / 0.13);
    border-radius: 10px;
    background: rgb(var(--tint) / 0.08);
  }

  .adv:nth-child(4n + 2) .adv__icon {
    --tint: 26 35 126;
  }

  .adv:nth-child(4n + 3) .adv__icon {
    --tint: 93 64 55;
  }

  .adv__title {
    margin-top: 14px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--color-text);
  }

  .adv__text {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 1199.98px) {
    .advantages {
      padding-top: 72px;
    }

    .advantages__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767.98px) {
    .advantages {
      padding-block: 48px;
    }

    .advantages__title {
      font-size: 28px;
      line-height: 1.4;
    }

    /* Horizontal scroll-snap carousel. */
    .advantages__list {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: calc(100% - 20px);
      gap: 11px;
      margin: 24px calc(-1 * var(--gutter)) 0;
      padding-inline: var(--gutter);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .advantages__list::-webkit-scrollbar {
      display: none;
    }

    .adv {
      scroll-snap-align: start;
      padding: 22px 16px;
    }

    .adv:nth-child(n) .adv__icon {
      --tint: 46 125 50;
    }

    .adv__title {
      font-size: 18px;
    }

    .adv__text {
      font-size: 14px;
      line-height: 1.5;
    }
  }
</style>
