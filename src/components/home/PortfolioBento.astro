---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { formatPrice } from '@/lib/site';

const MAX_ITEMS = 5;

const projects = (await getCollection('projects', ({ data }) => data.featured && !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, MAX_ITEMS);

const [lead, ...rest] = projects;
---

<section class="bento" aria-labelledby="bento-title">
  <div class="bento__inner">
    <div class="bento__head">
      <h2 class="bento__title" id="bento-title">
        <span>Более 840 проектов.</span>
        <em>Вот несколько.</em>
      </h2>
      <a class="bento__all" href="/portfolio/">Все<span class="visually-hidden"> проекты</span></a>
    </div>

    {
      lead && (
        <ul class="bento__grid" role="list" data-count={projects.length}>
          <li class="bento__item bento__item--lead">
            <a class="tile tile--lead" href={`/portfolio/${lead.id}/`}>
              <Image
                class="tile__image"
                src={lead.data.cover}
                alt={lead.data.coverAlt}
                widths={[380, 560, 760, 968]}
                sizes="(max-width: 767.98px) calc(50vw - 23px), (max-width: 1281px) 40vw, 484px"
                fit="cover"
              />
              <span class="tile__badge">{lead.data.badge}</span>
              <span class="tile__caption">
                <span class="tile__name">{lead.data.title}</span>
                <span class="tile__meta">
                  <span class="tile__location">{lead.data.location}</span>
                  <span class="tile__price">{formatPrice(lead.data.price)}</span>
                </span>
              </span>
            </a>
          </li>
          {rest.map((project) => (
            <li class="bento__item">
              <a class="tile" href={`/portfolio/${project.id}/`}>
                <Image
                  class="tile__image"
                  src={project.data.cover}
                  alt={project.data.coverAlt}
                  widths={[360, 540, 720]}
                  sizes="(max-width: 767.98px) calc(50vw - 23px), (max-width: 1281px) 29vw, 346px"
                  fit="cover"
                />
                <span class="tile__hover">
                  <span class="tile__name">{project.data.title}</span>
                  <span class="tile__location">{project.data.location}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .bento {
    position: relative;
    overflow: hidden;
    padding-block: 80px;
    background: var(--color-dark);
    color: var(--color-warm-white);
  }

  /* Ambient green glow. */
  .bento::before {
    content: '';
    position: absolute;
    top: -184px;
    left: 35%;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(45 90 61 / 0.07), transparent 70%);
    filter: blur(100px);
    pointer-events: none;
  }

  .bento__inner {
    position: relative;
    max-width: calc(1234px + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .bento__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-top: 22px;
  }

  .bento__title {
    display: flex;
    flex-direction: column;
    font-weight: 400;
    font-size: 48px;
    line-height: 1.05;
    letter-spacing: -1.5px;
  }

  .bento__title em {
    color: rgb(255 255 255 / 0.3);
  }

  .bento__all {
    flex-shrink: 0;
    padding: 13px 29px;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 14px;
    line-height: 21px;
    letter-spacing: -0.1px;
    color: var(--color-text-muted);
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .bento__all:hover {
    border-color: #fff;
    color: #fff;
  }

  /* ---------- Grid ---------- */
  .bento__grid {
    display: grid;
    grid-template-columns: 484fr 335fr 346fr;
    grid-template-rows: 243fr 317fr;
    gap: 44px 34px;
    height: min(606px, 49vw);
    min-height: 420px;
    margin-top: 32px;
  }

  .bento__item--lead {
    grid-row: 1 / span 2;
  }

  .bento__grid[data-count='1'] {
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
  }

  .bento__grid[data-count='2'],
  .bento__grid[data-count='3'] {
    grid-template-columns: 484fr 692fr;
  }

  .bento__grid[data-count='2'] .bento__item:not(.bento__item--lead) {
    grid-row: 1 / span 2;
  }

  .bento__grid[data-count='4'] .bento__item:last-child {
    grid-row: 1 / span 2;
  }

  .bento__item {
    min-width: 0;
    min-height: 0;
  }

  .tile {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: rgb(255 255 255 / 0.08);
    isolation: isolate;
  }

  .tile--lead {
    border: 1px solid rgb(255 255 255 / 0.14);
    box-shadow: var(--shadow-deep);
  }

  .tile__image {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease);
  }

  .tile:hover .tile__image {
    transform: scale(1.04);
  }

  .tile__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 4px 12px;
    border: 1px solid #fff;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.08);
    font-weight: 700;
    font-size: 11px;
    line-height: 15px;
    color: #fff;
  }

  .tile__caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    padding: 16px;
    background: linear-gradient(90deg, rgb(20 20 20 / 0.72), rgb(120 120 120 / 0.35));
    backdrop-filter: blur(20px);
  }

  .tile__name {
    font-weight: 600;
    font-size: 14px;
    line-height: 19.5px;
    color: var(--color-warm-white);
  }

  .tile__meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding-top: 4px;
  }

  .tile__location {
    font-size: 12px;
    line-height: 15px;
    color: rgb(255 255 255 / 0.45);
  }

  .tile__price {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 24px;
    color: #fff;
  }

  /* Plain tiles reveal the project name on hover/focus. */
  .tile__hover {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 40px 16px 14px;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.65));
    opacity: 0;
    transition: opacity var(--duration) var(--ease);
  }

  .tile:is(:hover, :focus-visible) .tile__hover {
    opacity: 1;
  }

  @media (max-width: 1199.98px) {
    .bento__title {
      font-size: clamp(32px, 4.4vw, 48px);
    }

    .bento__grid {
      gap: 24px;
    }
  }

  @media (max-width: 767.98px) {
    .bento {
      padding-block: 64px 40px;
    }

    .bento__inner {
      padding-inline: 18px;
    }

    .bento__head {
      gap: 12px;
      padding-top: 0;
    }

    .bento__title {
      font-size: 28px;
      line-height: 1.3;
      letter-spacing: -1px;
    }

    .bento__all {
      padding: 7px 16px;
      font-size: 13px;
    }

    .bento__grid,
    .bento__grid[data-count] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      grid-auto-rows: clamp(220px, 74vw, 300px);
      gap: 10px;
      height: auto;
      min-height: 0;
      margin-top: 40px;
    }

    .bento__grid .bento__item,
    .bento__grid .bento__item:last-child {
      grid-row: auto;
    }

    .bento__grid .bento__item--lead {
      grid-row: span 2;
    }

    .bento__grid[data-count='1'] .bento__item--lead {
      grid-column: 1 / -1;
    }

    .tile__caption {
      padding: 12px;
    }

    .tile__name {
      font-size: 13px;
    }

    .tile__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .tile__location {
      font-size: 11px;
    }

    .tile__price {
      font-size: 16px;
    }

    .tile__hover {
      padding: 32px 12px 12px;
    }

    .tile__hover .tile__name {
      font-size: 12px;
    }
  }
</style>
