---
import { getCollection } from 'astro:content';
import Stars from '@/assets/home/icons/stars-5.svg';
import Arrow from '@/assets/home/icons/arrow-down.svg';

import source from '@/content/data/reviews.json';

// The file loader doesn't keep array order — follow the order set in the CMS.
const order = source.items.map((item) => item.id);
const reviews = (await getCollection('reviews')).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---

{
  reviews.length > 0 && (
    <section class="reviews" aria-labelledby="reviews-title">
      <div class="reviews__head">
        <h2 class="reviews__title" id="reviews-title">
          Почему нас выбирают?
        </h2>
        <div class="reviews__nav" data-reviews-nav hidden>
          <button class="reviews__arrow reviews__arrow--prev" type="button" aria-controls="reviews-track" data-dir="-1">
            <Arrow width={24} height={24} aria-hidden="true" />
            <span class="visually-hidden">Предыдущий отзыв</span>
          </button>
          <button class="reviews__arrow reviews__arrow--next" type="button" aria-controls="reviews-track" data-dir="1">
            <Arrow width={24} height={24} aria-hidden="true" />
            <span class="visually-hidden">Следующий отзыв</span>
          </button>
        </div>
      </div>
      <ul class="reviews__track" id="reviews-track" role="list" tabindex="0" aria-label="Отзывы клиентов">
        {reviews.map(({ data }) => (
          <li class="review">
            <div class="review__profile">
              <p class="review__name">{data.name}</p>
              <p class="review__object">{data.object}</p>
            </div>
            <div class="review__body">
              <span class="review__stars" style={{ '--rating': data.rating }}>
                <Stars width={128} height={24} aria-hidden="true" />
                <span class="visually-hidden">Оценка {data.rating} из 5</span>
              </span>
              <p class="review__text">{data.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .reviews {
    --edge: max(var(--gutter), calc((100% - 1192px) / 2));
    padding-block: 65px 70px;
  }

  .reviews__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-inline: var(--edge);
    padding-left: calc(var(--edge) + 11px);
  }

  .reviews__nav {
    display: flex;
    flex-shrink: 0;
    gap: 12px;
  }

  .reviews__nav[hidden] {
    display: none;
  }

  .reviews__arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface);
    cursor: pointer;
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease),
      opacity var(--duration) var(--ease);
  }

  .reviews__arrow--prev :global(svg) {
    transform: rotate(90deg);
  }

  .reviews__arrow--next :global(svg) {
    transform: rotate(-90deg);
  }

  .reviews__arrow:hover:not(:disabled) {
    border-color: var(--color-green);
    box-shadow: var(--shadow-card);
  }

  .reviews__arrow:focus-visible {
    outline: 2px solid var(--color-green);
    outline-offset: 2px;
  }

  .reviews__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .reviews__title {
    max-width: 480px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 36px;
    line-height: 52px;
    letter-spacing: -1px;
    color: #1e1e1e;
  }

  .reviews__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 404px;
    align-items: center;
    gap: 15px;
    margin-top: 48px;
    padding-inline: calc(var(--edge) + 11px) var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: calc(var(--edge) + 11px) var(--gutter);
    scrollbar-width: thin;
  }

  .reviews__track:focus-visible {
    outline-offset: -2px;
  }

  .review {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    color: #0f1125;
    scroll-snap-align: start;
  }

  .review__profile {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-bottom: 24px;
    border-bottom: 1px solid #e9eff5;
  }

  .review__name {
    font-weight: 600;
    font-size: 20px;
    line-height: 1.3;
  }

  .review__object {
    font-weight: 500;
    font-size: 16px;
    line-height: 1.5;
    color: #717276;
  }

  .review__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 24px;
  }

  .review__stars {
    display: block;
    width: calc(26px * var(--rating) - 4px);
    height: 24px;
    overflow: hidden;
  }

  .review__stars :global(svg) {
    max-width: none;
  }

  .review__text {
    font-weight: 500;
    font-size: 15px;
    line-height: 1.9;
  }

  @media (max-width: 1199.98px) {
    .reviews__head {
      padding-left: var(--edge);
    }

    .reviews__track {
      padding-left: var(--edge);
      scroll-padding-left: var(--edge);
    }
  }

  @media (max-width: 767.98px) {
    .reviews {
      --edge: var(--gutter);
      padding-block: 48px 56px;
    }

    /* Phones swipe; the arrows would only crowd the heading. */
    .reviews__nav:not([hidden]) {
      display: none;
    }

    .reviews__head {
      padding-left: var(--edge);
    }

    .reviews__title {
      font-size: 28px;
      line-height: 1.3;
      letter-spacing: -0.5px;
    }

    .reviews__track {
      grid-auto-columns: calc(100% - 12px);
      align-items: stretch;
      gap: 12px;
      margin-top: 24px;
      padding-inline: var(--edge);
      scroll-padding-inline: var(--edge);
      scrollbar-width: none;
    }

    .reviews__track::-webkit-scrollbar {
      display: none;
    }

    .review {
      padding: 20px;
    }

    .review__profile {
      padding-bottom: 14px;
    }

    .review__name {
      font-size: 16px;
    }

    .review__object {
      font-size: 13px;
    }

    .review__body {
      gap: 10px;
      padding-top: 14px;
    }

    .review__stars {
      transform: scale(0.85);
      transform-origin: left center;
    }

    .review__text {
      font-size: 14px;
      line-height: 1.6;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-reviews-nav]');
  const track = document.getElementById('reviews-track');

  if (nav && track) {
    const [prev, next] = nav.querySelectorAll<HTMLButtonElement>('button');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const step = () => {
      const card = track.querySelector<HTMLElement>('li');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      nav.hidden = max <= 1;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    nav.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-dir]');
      if (!button) return;
      track.scrollBy({
        left: Number(button.dataset.dir) * step(),
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
    });

    track.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  }
</script>
