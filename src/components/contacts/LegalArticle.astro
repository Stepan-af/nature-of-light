---
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';

export interface Props {
  title: string;
  /** Small line under the title, e.g. edition date. */
  meta?: string;
  /** Wider container for tables. */
  wide?: boolean;
}

const { title, meta, wide = false } = Astro.props;
---

<div class="container legal-wrap">
  <article class:list={['legal', { 'legal--wide': wide }]}>
    <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: title }]} />
    <header class="legal__head">
      <h1 class="legal__title">{title}</h1>
      {meta && <p class="legal__meta">{meta}</p>}
    </header>
    <div class="legal__body">
      <slot />
    </div>
  </article>
</div>

<style>
  .legal-wrap {
    padding-top: 28px;
    padding-bottom: var(--section-pad);
  }

  .legal {
    max-width: 760px;
  }

  .legal--wide {
    max-width: 880px;
  }

  .legal__head {
    padding-top: 24px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-border);
  }

  .legal__title {
    font-size: clamp(27px, 4vw, 44px);
    line-height: 1.12;
    overflow-wrap: break-word;
    hyphens: auto;
    letter-spacing: -0.5px;
    color: var(--color-text-strong);
  }

  .legal__meta {
    margin-top: 12px;
    font-size: 14px;
    line-height: 22px;
    color: var(--color-text-soft);
  }

  .legal__body {
    padding-top: 32px;
    font-size: 16px;
    line-height: 1.7;
    color: #344054;
  }

  .legal__body :global(h2) {
    margin-top: 40px;
    margin-bottom: 12px;
    font-size: clamp(21px, 2.2vw, 24px);
    line-height: 1.25;
    color: var(--color-text-strong);
  }

  .legal__body :global(h2:first-child) {
    margin-top: 0;
  }

  .legal__body :global(p + p),
  .legal__body :global(p + ul),
  .legal__body :global(ul + p) {
    margin-top: 12px;
  }

  .legal__body :global(ul) {
    padding-left: 22px;
  }

  .legal__body :global(li + li) {
    margin-top: 6px;
  }

  .legal__body :global(li::marker) {
    color: var(--color-green);
  }

  .legal__body :global(a) {
    color: var(--color-green);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .legal__body :global(a:hover) {
    color: var(--color-green-pressed);
  }

  @media (max-width: 767.98px) {
    .legal-wrap {
      padding-top: 16px;
    }

    .legal__head {
      padding-top: 16px;
      padding-bottom: 24px;
    }

    .legal__body {
      padding-top: 24px;
      font-size: 15px;
      line-height: 1.65;
    }

    .legal__body :global(h2) {
      margin-top: 32px;
    }
  }
</style>
