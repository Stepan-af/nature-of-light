---
import { getCollection } from 'astro:content';
import Button from '@/components/ui/Button.astro';

export interface Props {
  /** `source` value of the lead form (see CLAUDE.md → Forms contract). */
  source?: string;
  class?: string;
}

const { source = 'contacts', class: className } = Astro.props;

/* Titles for ?service=<id> so the manager sees a readable subject. */
const services = [...(await getCollection('extraServices')), ...(await getCollection('serviceSteps'))];
const serviceTitles = Object.fromEntries(services.map((s) => [s.id, s.data.title]));
---

<form
  class:list={['request', className]}
  data-lead-form
  data-service-titles={JSON.stringify(serviceTitles)}
  action="/api/send.php"
  method="post"
  novalidate
>
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="context" value="" />

  <p class="request__caption" id="request-caption">
    Заполните форму, мы свяжемся с вами в ближайшее время и уточним все детали.
  </p>

  <p class="request__context" data-context-note hidden></p>

  <div class="request__fields">
    <div class="field">
      <label class="field__label" for="request-name">
        <span aria-hidden="true">01</span> Имя
      </label>
      <input
        class="field__input"
        id="request-name"
        name="name"
        type="text"
        autocomplete="name"
        placeholder="Ваше имя"
        required
        maxlength="100"
        aria-describedby="request-name-error"
      />
      <p class="field__error" id="request-name-error" data-error-for="name" aria-live="polite"></p>
    </div>

    <div class="field">
      <label class="field__label" for="request-phone">
        <span aria-hidden="true">02</span> Телефон
      </label>
      <input
        class="field__input"
        id="request-phone"
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        placeholder="Номер телефона"
        required
        maxlength="30"
        aria-describedby="request-phone-error"
      />
      <p class="field__error" id="request-phone-error" data-error-for="phone" aria-live="polite"></p>
    </div>

    <div class="field">
      <label class="field__label" for="request-comment">
        <span aria-hidden="true">03</span> Комментарий <span class="field__optional">· необязательно</span>
      </label>
      <textarea
        class="field__input field__input--area"
        id="request-comment"
        name="comment"
        rows="2"
        maxlength="2000"
        placeholder="Что планируете построить?"
        aria-describedby="request-comment-error"></textarea>
      <p class="field__error" id="request-comment-error" data-error-for="comment" aria-live="polite"></p>
    </div>
  </div>

  <input
    class="visually-hidden"
    name="website"
    type="text"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <Button class="request__submit" variant="outline" type="submit" block>
    <span>Отправить форму</span>
    <span class="request__arrow" aria-hidden="true">→</span>
  </Button>

  <p class="request__consent">
    Нажимая кнопку, вы соглашаетесь с{' '}
    <a href="/politika-konfidencialnosti/">политикой конфиденциальности</a>
  </p>

  <p class="request__status" data-form-status role="status" aria-live="polite"></p>
</form>

<script>
  import '@/scripts/lead-form';

  /*
   * Prefill the hidden `context` field from ?product=, ?project= or ?service=
   * so the manager knows what the lead is about.
   */
  const labels = { product: 'Товар', project: 'Проект', service: 'Услуга' } as const;
  const params = new URLSearchParams(location.search);

  for (const form of document.querySelectorAll<HTMLFormElement>('form.request[data-lead-form]')) {
    const input = form.querySelector<HTMLInputElement>('input[name="context"]');
    if (!input) continue;

    let titles: Record<string, string> = {};
    try {
      titles = JSON.parse(form.dataset.serviceTitles ?? '{}');
    } catch {
      /* ignore malformed data */
    }

    const parts: string[] = [];
    for (const key of Object.keys(labels) as (keyof typeof labels)[]) {
      const raw = params.get(key)?.trim().slice(0, 120);
      if (!raw) continue;
      const value = key === 'service' ? (titles[raw] ?? raw) : raw;
      parts.push(`${labels[key]}: ${value}`);
    }
    if (parts.length === 0) continue;

    input.value = parts.join('; ');
    const note = form.querySelector<HTMLElement>('[data-context-note]');
    if (note) {
      note.textContent = `Тема заявки — ${input.value}`;
      note.hidden = false;
    }
  }
</script>

<style>
  .request {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .request__caption,
  .field__label {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
  }

  .request__context {
    margin-top: 12px;
    padding: 8px 12px;
    border-left: 2px solid var(--color-green-pale);
    font-size: 13px;
    line-height: 19px;
    color: rgb(255 255 255 / 0.75);
    overflow-wrap: anywhere;
  }

  .request__fields {
    display: flex;
    flex-direction: column;
    padding-top: 24px;
  }

  .field {
    display: flex;
    flex-direction: column;
  }

  .field__label {
    font-weight: 500;
    transition: color var(--duration) var(--ease);
  }

  .field__optional {
    color: rgb(255 255 255 / 0.55);
  }

  .field__input {
    width: 100%;
    height: 57px;
    padding: 18px 0 14px;
    border: 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 0;
    appearance: none;
    background: transparent;
    font-size: 16px;
    line-height: 24px;
    color: #fff;
    outline: none;
    transition: border-color var(--duration) var(--ease);
  }

  .field__input--area {
    height: auto;
    min-height: 57px;
    max-height: 240px;
    resize: vertical;
    field-sizing: content;
  }

  .field__input::placeholder {
    color: rgb(255 255 255 / 0.5);
    opacity: 1;
    transition: color var(--duration) var(--ease);
  }

  .field__input:hover {
    border-bottom-color: rgb(255 255 255 / 0.5);
  }

  .field__input:focus-visible {
    border-bottom-color: #fff;
    box-shadow: inset 0 -1px 0 #fff;
  }

  .field__input:hover::placeholder,
  .field__input:focus::placeholder {
    color: #fff;
  }

  .field:has(.field__input:not(:placeholder-shown)) .field__label,
  .field:focus-within .field__label {
    color: #fff;
  }

  .field__input:not(:placeholder-shown) {
    border-bottom-color: #fff;
  }

  /* Invalid: aria-invalid from the lead-form script, or a filled [data-error-for] message. */
  .field__input[aria-invalid='true'],
  .field:has([data-error-for]:not(:empty)) .field__input {
    border-bottom-color: #ff6b66;
    box-shadow: inset 0 -1px 0 #ff6b66;
  }

  .field__error {
    padding-block: 6px 4px;
    font-size: 12px;
    line-height: 16px;
    color: #ff6b66;
  }

  .field__error:empty {
    display: none;
  }

  /* Submit: "ОТПРАВИТЬ ФОРМУ →" (contacts design overrides the kit's mono outline). */
  .request :global(.request__submit) {
    justify-content: space-between;
    margin-top: 48px;
    min-height: 65px;
    padding: 18px 28px;
    border-color: #8a8a8a;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    line-height: 21px;
    letter-spacing: 0.06em;
    color: #9a9a9a;
  }

  .request :global(.request__submit:hover),
  .request :global(.request__submit:focus-visible) {
    border-color: #fff;
    color: #fff;
    background: rgb(255 255 255 / 0.04);
  }

  .request__arrow {
    font-weight: 300;
    font-size: 18px;
    line-height: 27px;
    color: #fff;
    transition: transform var(--duration) var(--ease);
  }

  .request :global(.request__submit:hover) .request__arrow {
    transform: translateX(4px);
  }

  .request__consent {
    padding-top: 14px;
    font-size: 12px;
    line-height: 17px;
    color: rgb(255 255 255 / 0.55);
  }

  .request__consent a {
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.25);
    text-underline-offset: 3px;
    transition:
      color var(--duration) var(--ease),
      text-decoration-color var(--duration) var(--ease);
  }

  .request__consent a:hover {
    color: #fff;
    text-decoration-color: currentColor;
  }

  .request__status {
    margin-top: 16px;
    font-size: 14px;
    line-height: 21px;
  }

  .request__status:empty {
    display: none;
  }

  /* States toggled by src/scripts/lead-form.ts */
  .request[data-state='submitting'] :global(.request__submit) {
    cursor: progress;
    opacity: 0.6;
    pointer-events: none;
  }

  .request[data-state='submitting'] .request__arrow {
    animation: request-nudge 0.9s var(--ease) infinite;
  }

  .request[data-state='success'] .request__status {
    padding: 14px 16px;
    border: 1px solid rgb(146 200 149 / 0.4);
    border-radius: 4px;
    background: rgb(46 125 50 / 0.12);
    color: var(--color-green-pale);
  }

  .request[data-state='error'] .request__status {
    padding: 14px 16px;
    border: 1px solid rgb(255 107 102 / 0.4);
    border-radius: 4px;
    background: rgb(236 34 31 / 0.08);
    color: #ff8a86;
  }

  @keyframes request-nudge {
    50% {
      transform: translateX(6px);
    }
  }

  @media (max-width: 767.98px) {
    .request__fields {
      padding-top: 16px;
    }

    .field__input {
      height: 52px;
      padding: 16px 0 12px;
    }

    .request :global(.request__submit) {
      margin-top: 32px;
      min-height: 54px;
      padding: 14px 20px;
      font-size: 13px;
    }
  }
</style>
