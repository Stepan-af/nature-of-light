---
import { Font } from 'astro:assets';
import Seo, { type Props as SeoProps } from '@/components/seo/Seo.astro';
import SiteSchema from '@/components/seo/SiteSchema.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import '@/styles/global.css';

export interface Props extends SeoProps {
  /** Page background: light grey (catalog, portfolio), white (default) or dark (contacts). */
  tone?: 'white' | 'light' | 'dark';
}

const { tone = 'white', ...seo } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10111a" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Preload the regular faces (Cyrillic + Latin, digits live in Latin); italic and mono load on demand. -->
    <Font cssVariable="--font-display" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-body" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-mono" />
    <Seo {...seo} />
    <SiteSchema />
    <slot name="head" />
  </head>
  <body data-tone={tone}>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  body[data-tone='light'] {
    background: var(--color-bg);
  }

  body[data-tone='dark'] {
    background: var(--color-dark-alt);
    color: var(--color-text-on-dark);
  }
</style>
